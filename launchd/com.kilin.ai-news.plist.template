<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kilin.ai-news</string>

    <!-- 一個 job 依序跑三種週期（run_slot.sh），不是三個 job 各排同一個整點。
         三個 job 同時觸發會搶 ../ai-news-state 的 git index.lock，先到的成功、
         後到的莫名其妙失敗。非備稿日的週期會在腳本最前面秒退，成本趨近於零。

         外面包 caffeinate -i -s：系統睡眠設定是閒置 1 分鐘就睡，12:00 定時喚醒後
         若沒人碰鍵盤，產稿跑到一半就會被整機睡回去中斷。-i 擋閒置睡眠、-s 擋系統睡眠，
         撐到腳本結束為止。java-learn 那支從一開始就這樣寫，這裡是後來補齊的。
         過去 12:00 那班常常成功，是因為人在電腦前機器本來就醒著，沒暴露這個洞。 -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-i</string>
        <string>-s</string>
        <string>/bin/zsh</string>
        <string>__PROJECT_DIR__/run_slot.sh</string>
    </array>

    <!-- 只有 12:00 有 pmset 定時 FullWake 撐腰，是唯一保證跑得起來的班；
         13:00 是補救班，靠「你人在電腦前」的機會。兩班都在寄出班（雲端 14:00）之前。
         時間全部對齊整點，且刻意不排晚班——最後一班太晚的話，失敗了也沒時間補救。 -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <!-- 網路設定一變（接上 WiFi / 熱點、換網路）就再跑一次。
         固定班會漏：7/27 機器「醒著且有網路」的時間是 12:04–12:29，
         12:00 那班早了 4 分鐘、13:00 那班晚了 31 分鐘，兩班都沒踩進去。
         這裡改成不賭時刻——網路一通就動手，時間窗與去重交給 run_slot.sh 與 marker。
         launchd 不會讓同一個 Label 同時跑兩份，所以不必另外上鎖。 -->
    <key>WatchPaths</key>
    <array>
        <string>/Library/Preferences/SystemConfiguration</string>
        <string>/var/run/resolv.conf</string>
    </array>

    <!-- 網路設定在切換過程會連續改好幾次，限制最快 3 分鐘才能再啟動一次。 -->
    <key>ThrottleInterval</key>
    <integer>180</integer>

    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/launchd.err.log</string>
</dict>
</plist>
